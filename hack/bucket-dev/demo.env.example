# demo.env — Local configuration for bucket-dev scripts.
# Copy this file to demo.env and fill in your values.
# demo.env is gitignored and auto-sourced by all scripts.

# --- Required ---

# Path to GCS credentials JSON file (service account key or ADC).
GCS_CREDENTIALS_FILE=~/.config/gcloud/application_default_credentials.json

# GCS bucket name.
GCS_BUCKET=shachar-test

# --- Optional ---

# Key prefix within the bucket (default: bucket-dev/).
GCS_PREFIX=bucket-dev/

# VM backend: "multipass" (default) or "gcp".
VM_BACKEND=gcp

# --- GCP-specific (required when VM_BACKEND=gcp) ---

GCP_PROJECT=twistlock-dev-246815
GCP_ZONE=us-east1-b
GCP_NETWORK=bucket-demo-vpc
GCP_SUBNET=https://www.googleapis.com/compute/v1/projects/twistlock-dev-246815/regions/us-east1/subnetworks/bucket-demo-subnet
GCP_SERVICE_ACCOUNT=bucket-demo-worker@twistlock-dev-246815.iam.gserviceaccount.com
